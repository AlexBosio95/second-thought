FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app/backend
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt && groupadd --system app && useradd --system --gid app --home-dir /app app && mkdir -p /app/backend /data
COPY --chown=app:app backend/app /app/backend/app
COPY --chown=app:app benchmark/scenarios.json /app/benchmark/scenarios.json
RUN chown -R app:app /app/backend /data
COPY backend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 755 /usr/local/bin/docker-entrypoint.sh
USER root
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=3s --start-period=10s --retries=3 CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/health', timeout=2)"
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
